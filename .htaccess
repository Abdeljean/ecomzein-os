# Ecom Zein OS - Apache / LiteSpeed SPA Fallback Configuration
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Allow direct access to existing files & assets
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route API requests to Node server if active
  RewriteRule ^api/(.*)$ /api/$1 [L]

  # Route all frontend SPA routes to index.html
  RewriteRule . /index.html [L]
</IfModule>

# Enable Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Caching for PWA assets
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|json)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>
</IfModule>
