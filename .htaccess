# Ecom Zein OS - Direct High-Speed Static SPA Server Configuration
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Reverse Proxy API requests to Node.js Backend
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteRule ^api/(.*) http://127.0.0.1:5000/api/$1 [P,L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Enable Gzip / Brotli Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache-Control: Force fresh fetches for HTML & JS app shell, cache images
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>
  <FilesMatch "\.(css|png|jpg|jpeg|gif|ico|svg)$">
    Header set Cache-Control "max-age=604800, public"
  </FilesMatch>
</IfModule>
