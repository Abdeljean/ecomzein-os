PassengerAppRoot "/home/u721391917/domains/tassnimproduct.shop/public_html"
PassengerBaseURI "/"
PassengerNodejs "/nodevenv/domains/tassnimproduct.shop/public_html/20/bin/node"
PassengerAppType node
PassengerStartupFile server.js
# DO NOT REMOVE OR MODIFY. CLOUDLINUX PASSENGER CONFIGURATION END

# SPA Fallback & Static Assets
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
